# Project 1: PV Generation Volatility Analysis (Plant 2) - one cell, start to finish
import glob, numpy as np, pandas as pd
import matplotlib.pyplot as plt

# 1) Find the uploaded file automatically (works for .csv, .csv.zip or .zip)
files = glob.glob('Plant_2_Generation_Data*')
assert files, "Upload the Plant 2 generation file to Colab first (folder icon on the left)"
path = files[0]
print('Reading:', path)
df = pd.read_csv(path)            # pandas reads a zip directly if it has one file
df['DATE_TIME'] = pd.to_datetime(df['DATE_TIME'], dayfirst=True)
STEP_MIN = 15                     # data is sampled every 15 minutes

# 2) Aggregate plant power; trust only timestamps where ALL inverters reported
g = df.groupby('DATE_TIME').agg(AC_POWER=('AC_POWER', 'sum'),
                                n_inv=('SOURCE_KEY', 'nunique'))
print('Inverters per timestamp:\n', g['n_inv'].value_counts().sort_index())
g.loc[g['n_inv'] < g['n_inv'].max(), 'AC_POWER'] = np.nan   # incomplete -> missing
g = g.asfreq(f'{STEP_MIN}min')                              # gaps appear as NaN
plant = g[['AC_POWER']].copy()
print(f"Missing/invalid steps: {plant['AC_POWER'].isna().sum()} of {len(plant)}")

# 3) Ramp rate (NaN across gaps, so no fake spikes)
plant['Ramp'] = plant['AC_POWER'].diff() / STEP_MIN         # kW/min
P_rated = plant['AC_POWER'].quantile(0.999)
plant['Ramp_pct'] = plant['Ramp'] * STEP_MIN / P_rated * 100

# 4) Statistics (daytime only)
day = plant[plant['AC_POWER'] > 0.02 * P_rated].dropna()
print(f"\nMean plant AC power (daytime): {day['AC_POWER'].mean():.1f} kW")
print(f"Max surge: {plant['Ramp'].max():.1f} kW/min | Max drop: {plant['Ramp'].min():.1f} kW/min")
print('Daytime |ramp| percentiles (kW/min):')
print(day['Ramp'].abs().quantile([.5, .9, .95, .99]).round(1).to_string())
print(f"Daytime steps with a drop > 20% of rated in {STEP_MIN} min: {(day['Ramp_pct'] < -20).sum()}")

# 5) Plot
fig, (a1, a2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True)
a1.plot(plant.index, plant['AC_POWER'], color='darkorange', lw=1, label='Total plant AC power (kW)')
a1.set_title('Solar PV Generation Volatility (Plant 2, 15-min SCADA)', fontweight='bold')
a1.set_ylabel('AC power (kW)'); a1.legend(loc='upper right'); a1.grid(True, ls='--', alpha=.5)
a2.plot(plant.index, plant['Ramp'], color='crimson', lw=.7, alpha=.8, label='Ramp rate (kW/min)')
a2.axhline(0, color='k', lw=.8)
a2.set_title(f'Power ramp rate (change over {STEP_MIN} min / {STEP_MIN})', fontweight='bold')
a2.set_ylabel('kW/min'); a2.set_xlabel('Timestamp')
a2.legend(loc='upper right'); a2.grid(True, ls='--', alpha=.5)
plt.tight_layout()
plt.savefig('pv_volatility_plant2.png', dpi=300)
plt.show()
